---
// On every page: the protocol's release. A page's own banner, if it has one, follows.
import Default from "@astrojs/starlight/components/Banner.astro";

const locale = Astro.locals.starlightRoute.locale ?? "en";
const zh = locale === "zh";
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="asp-status" role="note">
  {zh ? "v0：ASP 的每一部分都在版本 0，2026-11-25 冻结，从此只做加法。" : "v0: every part of ASP is at version 0, frozen on 2026-11-25; from now on it only grows by addition."}
  <a href={`${root}/${locale}/docs/learn/versioning/`}>{zh ? "版本" : "Versions"}</a>
</div>
<Default />
